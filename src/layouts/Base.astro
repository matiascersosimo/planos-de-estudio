---
import '../styles/global.css';
import '../styles/plans.css';
import 'katex/dist/katex.min.css';
import { getEstudios } from '../lib/estudios';
import { SITE_NAME, AUTHOR, CONTACT, mailto } from '../data/site';
import { u } from '../lib/url';

interface Props { title?: string; description?: string; canonical?: string }
const { title, canonical, description = 'Guías de estudio con teoría, ejemplos y práctica, organizadas por carrera y por materia.' } = Astro.props;
const pageTitle = title ? `${title} | ${SITE_NAME}` : SITE_NAME;
const { escuelas, disponibles } = await getEstudios();
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="description" content={description} />
  <meta name="author" content={AUTHOR} />
  <title>{pageTitle}</title>
  {canonical && <link rel="canonical" href={canonical} />}
  <link rel="icon" type="image/svg+xml" href={u('favicon.svg')} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700;800&family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500;600&display=swap" rel="stylesheet" />
</head>
<body>
  <header>
    <div class="wrap bar">
      <a class="brand" href={u()} aria-label={`${SITE_NAME}, inicio`}>
        <span class="brand-mark" aria-hidden="true">P/E</span>
        <span class="brand-copy">{SITE_NAME}<small>Biblioteca de acceso abierto</small></span>
      </a>
      <nav class="main" aria-label="Principal">
        <div class="dd">
          <button class="dd-btn" id="ddBtn" aria-expanded="false" aria-controls="ddMenu">Carreras <span aria-hidden="true">▾</span></button>
          <div class="dd-menu" id="ddMenu" hidden>
            <div class="wrap">
              {escuelas.map((e) => (
                <div class="g">
                  <b>{e.nombre}</b>
                  {e.areas.map((a) => (
                    <>
                      <i>{a.nombre}</i>
                      {a.carreras.map((c) => (
                        <a href={u(c.id + '/')}>
                          <span>{c.nombre}</span>
                          <span class="status live">Con guías</span>
                        </a>
                      ))}
                    </>
                  ))}
                </div>
              ))}
            </div>
          </div>
        </div>
        <a href={u('#guias')}>Guías</a>
        <a href={u('acerca/')}>El proyecto</a>
        <a href={u('contacto/')}>Contacto</a>
      </nav>
    </div>
  </header>

  <main><slot /></main>

  <footer>
    <div class="wrap">
      <div class="foot">
        <div><b>{SITE_NAME}</b>Guías de estudio con teoría, ejemplos y práctica, organizadas por carrera y por materia.</div>
        <div><b>Carreras con guías</b>{disponibles.slice(0, 3).map(c => <a href={u(c.id + '/')}>{c.nombre}</a>)}<a href={u()}>Ver todas</a></div>
        <div><b>{AUTHOR}</b><a href={u('#guias')}>Guías</a>
        <a href={u('acerca/')}>El proyecto</a><a href={mailto('Contacto desde Planos de estudio')}>{CONTACT}</a></div>
      </div>
      <div class="legal">Proyecto estudiantil independiente, sin afiliación oficial a ninguna universidad. El contenido es de apoyo y no reemplaza el material de la cátedra.</div>
    </div>
  </footer>

  <script is:inline>
    (function () {
      var btn = document.getElementById('ddBtn'), menu = document.getElementById('ddMenu');
      function close() { menu.hidden = true; btn.setAttribute('aria-expanded', 'false'); }
      btn.addEventListener('click', function (e) {
        e.stopPropagation();
        var open = menu.hidden; menu.hidden = !open; btn.setAttribute('aria-expanded', String(open));
      });
      document.addEventListener('click', function (e) { if (!menu.contains(e.target)) close(); });
      addEventListener('keydown', function (e) { if (e.key === 'Escape') close(); });
    })();
  </script>
</body>
</html>
