---
import { getEstudios, idsDeCarrera } from '../../lib/estudios';
import { u } from '../../lib/url';

// Compatibilidad con los marcadores anteriores: no se vuelve a renderizar el manual.
export async function getStaticPaths() {
  const { disponibles, materias } = await getEstudios();
  return disponibles.flatMap(c => [...idsDeCarrera(c.entry)]
    .filter(id => materias.get(id)?.disponible)
    .map(id => ({ params: { carrera: c.id, materia: id }, props: { id: materias.get(id)!.manualId, nombre: materias.get(id)!.data.nombre } })));
}
const { id, nombre } = Astro.props;
const target = u(`materias/${id}/`);
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{nombre} · Dirección de la guía</title>
    <link rel="canonical" href={target} />
    <noscript><meta http-equiv="refresh" content={`0;url=${target}`} /></noscript>
  </head>
  <body>
    <p>La guía tiene una dirección compartida para todas las carreras. <a href={target}>Abrir {nombre}</a>.</p>
    <script is:inline define:vars={{ target }}>
      window.location.replace(target + window.location.search + window.location.hash);
    </script>
  </body>
</html>
