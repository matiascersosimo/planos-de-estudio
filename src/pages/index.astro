---
import Base from '../layouts/Base.astro';
import Row from '../components/Row.astro';
import { getEstudios } from '../lib/estudios';
import { u } from '../lib/url';
import { AUTHOR } from '../data/site';

const { disponibles: carreras, materias, escuelas } = await getEstudios();
const porId = new Map(carreras.map(c => [c.id, c]));
const nMaterias = new Set([...materias.values()].filter(m => m.disponible).map(m => m.manualId)).size;

// Texto normalizado (sin tildes, en minúsculas) para que el buscador encuentre "informatica" o "Informática".
const norm = (s: string) => s.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();
---
<Base>
  <div class="hero"><div class="wrap"><div class="sheet">
    <h1>Guías de estudio para toda tu carrera</h1>
    <p class="lead">Teoría, fórmulas y puntos clave de cada materia, ordenados para estudiar y para repasar antes de rendir.</p>
    <div class="titleblock">
      <div><small>Autor</small>{AUTHOR}</div>
      <div><small>Carreras</small>{carreras.length}</div>
      <div><small>Materias</small>{nMaterias}</div>
    </div>
  </div></div></div>

  <div class="wrap">
    <div class="search" role="search">
      <label for="q">Buscar carrera</label>
      <div class="box">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#8fd0ff" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="M15.5 15.5L21 21"/></svg>
        <input id="q" type="search" autocomplete="off" placeholder="Ej: informática, sistemas, ingeniería" />
      </div>
      <p class="meta" id="qmeta" aria-live="polite"></p>
    </div>

    <p class="none" id="sinResultados" hidden>
      No encontramos carreras que coincidan. ¿Falta la tuya? <a href={u('contacto/')}>Escribinos</a>.
    </p>

    <p class="catalogue-note">Mostramos las carreras que ya tienen al menos una guía. Los planes están contrastados con la versión enlazada por UNNOBA; las guías se incorporan por materia.</p>
    {escuelas.map((e) => (
      <section class="block esc">
        <h2>{e.nombre}</h2>
        <p class="sub">{e.completo}</p>
        {e.areas.map((a) => (
          <div class="area">
            <h3 class="grp">{a.nombre}</h3>
            <div class="list">
              {a.carreras.map((c) => (
                <div data-carrera data-q={norm([c.nombre, c.code, a.nombre, e.nombre, e.completo].join(' '))}>
                  <Row
                    href={u(c.id + '/')}
                    code={c.code}
                    nombre={c.nombre}
                    desc={`Plan ${porId.get(c.id)!.entry.data.planVersion} · ${porId.get(c.id)!.guias} ${porId.get(c.id)!.guias === 1 ? 'guía disponible' : 'guías disponibles'}.`}
                    estado="Con guías"
                    live={true}
                  />
                </div>
              ))}
            </div>
          </div>
        ))}
      </section>
    ))}
  </div>
</Base>

<style>
  .search { margin: 48px 0 0; }
  .search label { display: block; font: 500 0.78rem var(--mono); color: var(--accent); margin-bottom: 8px; letter-spacing: 0.02em; }
  .box { position: relative; }
  .box svg { position: absolute; left: 15px; top: 50%; transform: translateY(-50%); pointer-events: none; }
  .search input {
    width: 100%; font: inherit; font-size: 1.05rem; color: var(--ink);
    background: rgba(10, 34, 67, 0.85); border: 1px solid var(--line-strong);
    border-radius: 0; padding: 14px 16px 14px 46px;
  }
  .search input::placeholder { color: var(--ink-dim); }
  .search input:focus { outline: 2px solid var(--accent); outline-offset: 2px; }
  .meta { min-height: 1.4em; margin: 8px 2px 0; font-size: 0.82rem; color: var(--ink-dim); }
  .none { padding: 36px 0; color: var(--ink-dim); }
  .none a { color: var(--accent); }
</style>

<script>
  const input = document.getElementById('q') as HTMLInputElement;
  const items = [...document.querySelectorAll<HTMLElement>('[data-carrera]')];
  const areas = [...document.querySelectorAll<HTMLElement>('.area')];
  const escuelas = [...document.querySelectorAll<HTMLElement>('section.esc')];
  const sinResultados = document.getElementById('sinResultados') as HTMLElement;
  const meta = document.getElementById('qmeta') as HTMLElement;

  const norm = (s: string) => s.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();
  const visible = (el: HTMLElement) => el.querySelector('[data-carrera]:not([hidden])') !== null;

  function filtrar() {
    const tokens = norm(input.value).split(/\s+/).filter(Boolean);
    let n = 0;
    for (const el of items) {
      const ok = tokens.every((t) => (el.dataset.q ?? '').includes(t));
      el.hidden = !ok;
      if (ok) n++;
    }
    areas.forEach((a) => (a.hidden = !visible(a)));
    escuelas.forEach((e) => (e.hidden = !visible(e)));
    sinResultados.hidden = n > 0;
    meta.textContent = tokens.length ? `${n} ${n === 1 ? 'carrera' : 'carreras'}` : '';
  }

  input.addEventListener('input', filtrar);
  input.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') { input.value = ''; filtrar(); }
  });
</script>
